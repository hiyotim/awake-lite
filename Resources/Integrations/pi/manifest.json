{
  "schema": 1,
  "family": "pi",
  "displayName": "Pi",
  "packageVersion": "1",
  "requiresRestart": true,
  "requiresHookTrust": false,
  "notes": [
    "CLI target is unverified.",
    "Reload, session switch, and cancellation need a separate live check.",
    "Extension directory is the best-documented default."
  ],
  "targets": [
    {
      "id": "pi.cli",
      "mode": "cli",
      "capabilities": ["inProcessExtension"],
      "verificationLevel": "unverified"
    }
  ],
  "assets": [
    {
      "id": "extension",
      "source": "assets/awake-lite.pi.js",
      "destination": "extensions/awake-lite.pi.js"
    }
  ],
  "steps": [
    {
      "kind": "extensionFile",
      "target": "pi.cli",
      "format": "text",
      "configRoot": "~/.pi/agent/extensions",
      "path": "awake-lite/awake-lite.pi.js",
      "ownedEntries": [
        {
          "marker": "awake-lite/pi.cli/extension",
          "asset": "extension"
        }
      ]
    }
  ]
}
